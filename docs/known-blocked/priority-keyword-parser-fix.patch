diff --git a/cpp/parser/BNGParser.g4 b/cpp/parser/BNGParser.g4
index 168af2f..abec853 100644
--- a/cpp/parser/BNGParser.g4
+++ b/cpp/parser/BNGParser.g4
@@ -116,6 +116,11 @@ keyword_as_mol_name
     : SPECIES | MOLECULE | MOLECULES | REACTION | REACTIONS | RULES
     | PARAMETERS | OBSERVABLES | FUNCTIONS | COMPARTMENTS | ENERGY | PATTERNS
     | MODEL | SEED | GROUPS | POPULATION | COUNTER
+    // `priority` is a keyword only in the trailing rule modifier (`... rate priority=N`)
+    // and the bng3_events field (`priority: N`). The modifier alternative in
+    // rule_modifiers is only reachable after a complete rate law, never at a
+    // molecule-name position, so reading PRIORITY as a name here is unambiguous.
+    | PRIORITY
     ;
 
 // Allow numeric states like ~0~p and mixed like ~2P~10P (INT followed by STRING)
@@ -210,8 +215,17 @@ observables_block
     ;
 
 // Observable definition - type is optional (can be just "Name Pattern")
+// The name slot also accepts PRIORITY. `priority:` (COLON) is the bng3_events
+// field and lives in a different block, and an observable name is always followed
+// by a pattern list, so neither collides with the name reading of PRIORITY here.
 observable_def
-    : (STRING COLON)? observable_type? STRING observable_pattern_list
+    : (STRING COLON)? observable_type? observable_name observable_pattern_list
+    ;
+
+// Observable name - identifiers, plus keywords that cannot appear as an
+// observable_type (MOLECULES/SPECIES/COUNTER/STRING) in the position above.
+observable_name
+    : STRING | PRIORITY
     ;
 
 observable_type
@@ -548,9 +562,13 @@ arg_name
     // Visualize options
     | TYPE | BACKGROUND | COLLAPSE | OPTS | GROUPS
     // Safe/execute
-    // Safe/execute
     | SAFE | EXECUTE
     | TEXTREACTION | TEXTSPECIES
+    // `priority` is a keyword only in the trailing rule modifier form
+    // (`... rate priority=N`) and the bng3_events field (`priority: N`).
+    // As an expression identifier it is followed by an operator or a rule
+    // boundary, so the modifier's mandatory BECOMES cannot follow it here.
+    | PRIORITY
     ;
 
 expression_list
