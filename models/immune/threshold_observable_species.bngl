# The supported counterpart: the same count predicate on a Species observable.
#
# ``Species`` observables answer "how many species match", so the compared
# quantity is the number of embeddings of the pattern in a species graph.  For
# the single-node pattern Eff() that count is 1, which makes the predicate's
# meaning concrete and checkable:
#
#   Species SGt0  Eff()>0   -> 1  (one embedding, 1 > 0)
#   Species SGt1  Eff()>1   -> 0  (one embedding, 1 > 1)
#
# These are exact integers, not tolerances, and they match BNG2 2.9.3 on the
# same model.  A change that made the predicate amount-based instead of
# count-based would break these, which is the point of keeping them.

begin parameters
  k = 0.5
end parameters

begin molecule types
  Eff()
  Vac()
  Ch(c~a~b,c~a~b)
end molecule types

begin seed species
  Eff() 100
  Vac() 3
  Ch(c~a,c~b) 1
end seed species

begin observables
  Species SEff  Eff()
  Species SGt0  Eff()>0
  Species SGt1  Eff()>1
  Species SCh   Ch(c~a)
end observables

begin reaction rules
  Eff() -> 0   k
end reaction rules

begin actions
  generate_network({overwrite=>1})
  simulate({method=>"ode",t_end=>0.001,n_steps=>1,atol=>1e-10,rtol=>1e-10})
end actions
