begin model
begin parameters
  k 0.40000000000000002
  kr 0.20000000000000001
  N 20
  V 1
end parameters
begin compartments
  cell 3 V
end compartments
begin molecule types
  A()
  B()
end molecule types
begin seed species
  @cell:A() N
  @cell:B() 0
end seed species
begin observables
  Molecules A @cell:A()
  Molecules B @cell:B()
end observables
begin functions
  rate() = k
end functions
begin reaction rules
  forward: @cell:A() -> @cell:B() rate()
end reaction rules
end model

generate_network({overwrite=>1})
writeNetwork({overwrite=>1})
simulate({method=>"ode",t_end=>2,n_steps=>10,rtol=>1e-10,atol=>1e-12})
