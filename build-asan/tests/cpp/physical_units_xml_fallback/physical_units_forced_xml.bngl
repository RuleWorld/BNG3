begin model
  setOption("units", "strict")
  setOption("NumberPerQuantityUnit", 6.02214076e23)
  begin parameters
    k = 1e-9 [M/second]
  end parameters
  begin compartments
    cell 3 2 [fL]
  end compartments
  begin molecule types
    A()
  end molecule types
  begin seed species
    A()@cell 0
  end seed species
  begin reaction rules
    source: 0 -> A()@cell k
  end reaction rules
  begin actions
    simulate_nf({prefix=>"forced_xml",t_end=>1e-14,n_steps=>1,seed=>42})
  end actions
end model
