begin model
begin parameters
  N 3
  Nd 3
  p 1
  k 0.4
end parameters
begin molecule types
  A()
  B()
end molecule types
begin seed species
  A() 10
  B() 0
end seed species
begin observables
  Molecules A_count A()
  Molecules B_count B()
end observables
begin reaction rules
  convert: A() -> B() k
end reaction rules
begin protocol
simulate({method=>"ode",t_start=>0,t_end=>0.5,n_steps=>4})
setParameter("k","2^N")
setParameter("N",4)
simulate({method=>"ode",t_end=>0.5,n_steps=>4})
end protocol
end model
simulate_protocol()
generate_network({evaluate_expressions=>0})

