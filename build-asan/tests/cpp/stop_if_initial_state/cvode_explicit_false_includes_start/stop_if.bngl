begin model
begin parameters
  N 4
  k 0
end parameters
begin molecule types
  A()
  B()
end molecule types
begin seed species
  A() 10
  B() 0
end seed species
begin observables
  Molecules A_count A()
  Molecules B_count B()
end observables
begin reaction rules
  convert: A() -> B() k
end reaction rules
simulate({method=>"cvode",t_start=>2,t_end=>3,stop_if=>"A_count < 0",sample_times=>[2,2.25,2.5,2.75]})
end model
