begin model
begin parameters
  N 4
  k 1
end parameters
begin molecule types
  A()
  B()
end molecule types
begin seed species
  A() 10
  B() 0
end seed species
begin observables
  Molecules A_count A()
  Molecules B_count B()
end observables
begin reaction rules
  convert: A() -> B() k
end reaction rules
simulate({method=>"rk4",t_start=>0,t_end=>1,n_steps=>2,stop_if=>"2^N"})
end model
