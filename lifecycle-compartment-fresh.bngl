begin model
begin parameters
  k 0.40000000000000002
  N 20
  V 3
end parameters
begin compartments
  cell 3 V
end compartments
begin molecule types
  A()
  D()
end molecule types
begin seed species
  @cell:A() N
  @cell:D() 0
end seed species
begin observables
  Molecules A @cell:A()
  Molecules D @cell:D()
end observables
begin reaction rules
  dimerize: @cell:A() + @cell:A() -> @cell:D() 2*k
end reaction rules
end model
