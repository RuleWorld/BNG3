{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/RuleWorld/BNG3/provenance/schemas/golden-manifest.schema.json",
  "title": "BNG3 provenance-complete golden bundle manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "bundle_id",
    "status",
    "generated_at",
    "source_lock",
    "models",
    "corpus",
    "oracle",
    "build",
    "execution",
    "outputs",
    "notes"
  ],
  "properties": {
    "$schema": {"type": "string"},
    "schema_version": {"const": 1},
    "bundle_id": {"$ref": "#/$defs/digest"},
    "status": {"enum": ["candidate", "approved"]},
    "generated_at": {"type": "string", "format": "date-time"},
    "source_lock": {"$ref": "#/$defs/file_reference"},
    "models": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/model"}
    },
    "corpus": {"$ref": "#/$defs/corpus"},
    "oracle": {"$ref": "#/$defs/oracle"},
    "build": {"$ref": "#/$defs/build"},
    "execution": {"$ref": "#/$defs/execution"},
    "outputs": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/output"}
    },
    "notes": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "file_reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/digest"}
      }
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "path", "sha256"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/digest"}
      }
    },
    "corpus": {
      "type": "object",
      "additionalProperties": false,
      "required": ["selection_manifest", "rulehub"],
      "properties": {
        "selection_manifest": {"$ref": "#/$defs/file_reference"},
        "rulehub": {
          "type": "object",
          "additionalProperties": false,
          "required": ["repository", "revision"],
          "properties": {
            "repository": {
              "type": "string",
              "pattern": "^https://github\\.com/.+\\.git$"
            },
            "revision": {"$ref": "#/$defs/sha"}
          }
        }
      }
    },
    "oracle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "source",
        "repository",
        "revision",
        "build_recipe",
        "artifact_digest"
      ],
      "properties": {
        "name": {"enum": ["bng2", "nfsim"]},
        "source": {"enum": ["bionetgen", "nfsim"]},
        "repository": {
          "type": "string",
          "pattern": "^https://github\\.com/.+\\.git$"
        },
        "revision": {"$ref": "#/$defs/sha"},
        "build_recipe": {"type": "string", "minLength": 1},
        "artifact_digest": {"$ref": "#/$defs/digest"}
      }
    },
    "build": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "compiler",
        "compiler_version",
        "flags",
        "dependencies",
        "platform",
        "container_image"
      ],
      "properties": {
        "compiler": {"type": "string", "minLength": 1},
        "compiler_version": {"type": "string", "minLength": 1},
        "flags": {
          "type": "array",
          "items": {"type": "string"}
        },
        "dependencies": {
          "type": "array",
          "items": {"type": "string"}
        },
        "platform": {"type": "string", "minLength": 1},
        "container_image": {
          "type": "string",
          "pattern": "@sha256:[0-9a-f]{64}$"
        }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "command",
        "method",
        "seeds",
        "time_grid",
        "tolerances",
        "comparator_version"
      ],
      "properties": {
        "command": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "method": {
          "enum": ["network", "ode", "ssa", "pla", "psa", "nf"]
        },
        "seeds": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "integer", "minimum": 0}
        },
        "time_grid": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "number"}
        },
        "tolerances": {
          "type": "object",
          "additionalProperties": false,
          "required": ["absolute", "relative"],
          "properties": {
            "absolute": {"type": "number", "minimum": 0},
            "relative": {"type": "number", "minimum": 0}
          }
        },
        "comparator_version": {"type": "string", "minLength": 1}
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "model_id", "kind", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "model_id": {"type": "string", "minLength": 1},
        "kind": {
          "enum": ["net", "gdat", "cdat", "xml", "sbml", "bngl", "json", "other"]
        },
        "sha256": {"$ref": "#/$defs/digest"}
      }
    }
  }
}
