diff --git a/cpp/engine/ObservableProjection.cpp b/cpp/engine/ObservableProjection.cpp
new file mode 100644
index 0000000..b75e870
--- /dev/null
+++ b/cpp/engine/ObservableProjection.cpp
@@ -0,0 +1,102 @@
+#include "ObservableProjection.hpp"
+
+#include <limits>
+#include <stdexcept>
+
+#include "compile/CompiledModel.hpp"
+#include "compile/PatternLowering.hpp"
+#include "core/PatternMatching.hpp"
+
+namespace bng::engine {
+namespace {
+
+bool relationSatisfied(std::size_t count, const std::string& relation, int quantity) {
+    if (relation.empty()) return count > 0;
+    if (quantity < 0) return false;
+    const auto q = static_cast<std::size_t>(quantity);
+    if (relation == "==") return count == q;
+    if (relation == "!=") return count != q;
+    if (relation == ">") return count > q;
+    if (relation == ">=") return count >= q;
+    if (relation == "<") return count < q;
+    if (relation == "<=") return count <= q;
+    return false;
+}
+
+struct LoweredTerm {
+    BNGcore::PatternGraph pattern;
+    std::string relation;
+    int quantity = 0;
+};
+
+std::size_t moleculesWeight(const std::vector<LoweredTerm>& terms,
+                            const BNGcore::PatternGraph& target) {
+    std::size_t weight = 0;
+    for (const auto& term : terms) {
+        const auto matches = core::countPatternMatches(term.pattern, target);
+        if (std::numeric_limits<std::size_t>::max() - weight < matches)
+            throw std::overflow_error("observable match count overflow");
+        weight += matches;
+    }
+    return weight;
+}
+
+std::size_t speciesWeight(const std::vector<LoweredTerm>& terms,
+                          const BNGcore::PatternGraph& target) {
+    // BNG2 Species observables contribute one unit per term whose
+    // stoichiometric constraint is satisfied by the generated species.
+    std::size_t weight = 0;
+    for (const auto& term : terms) {
+        const auto matches = core::countPatternMatches(term.pattern, target);
+        if (relationSatisfied(matches, term.relation, term.quantity)) ++weight;
+    }
+    return weight;
+}
+
+} // namespace
+
+std::vector<ObservableProjectionGroup> projectObservables(
+    const compile::CompiledModel& model,
+    const GeneratedNetwork& network) {
+    compile::BNGcoreLoweringContext lowering(model);
+    std::vector<ObservableProjectionGroup> groups;
+    groups.reserve(model.observables().size());
+
+    for (const auto& observable : model.observables()) {
+        ObservableProjectionGroup group;
+        group.name = observable.name;
+        group.type = observable.type;
+
+        std::vector<LoweredTerm> terms;
+        terms.reserve(observable.terms.size());
+        for (const auto& term : observable.terms) {
+            if (!term.pattern.isResolved())
+                throw std::invalid_argument("observable pattern is not semantically resolved: " +
+                                            observable.name);
+            terms.push_back(LoweredTerm{
+                compile::lowerPatternToBNGcore(term.pattern, lowering, true),
+                term.relation,
+                term.quantity});
+        }
+
+        for (std::size_t speciesIndex = 0;
+             speciesIndex < network.species.size(); ++speciesIndex) {
+            const auto& target = network.species.get(speciesIndex).getSpeciesGraph().getGraph();
+            std::size_t weight = 0;
+            if (observable.kind == compile::ObservableKind::Species) {
+                weight = speciesWeight(terms, target);
+            } else if (observable.kind == compile::ObservableKind::Molecules) {
+                weight = moleculesWeight(terms, target);
+            } else {
+                throw std::invalid_argument("unsupported observable kind in projection: " +
+                                            observable.name);
+            }
+            if (weight > 0) group.entries.emplace_back(speciesIndex, weight);
+        }
+
+        groups.push_back(std::move(group));
+    }
+    return groups;
+}
+
+} // namespace bng::engine
