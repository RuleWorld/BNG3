begin model
begin parameters
  k 0.1
end parameters
begin molecule types
  A(b)
end molecule types
begin seed species
  A(b) 10
end seed species
begin observables
  Molecules Total A()
  Species Dimer A(b!1).A(b!1)
end observables
begin reaction rules
  A(b) + A(b) -> A(b!1).A(b!1) k
end reaction rules
end model
begin actions
  generate_network({overwrite=>1})
end actions
