begin model
begin parameters
  k 0.5
end parameters
begin molecule types
  A()
  B()
end molecule types
begin seed species
  A() 10
  B() 3
end seed species
begin observables
  Molecules A_free A()
  Molecules Total A() B()
end observables
begin reaction rules
  A() -> B() k
end reaction rules
end model
begin actions
  generate_network({overwrite=>1})
end actions
