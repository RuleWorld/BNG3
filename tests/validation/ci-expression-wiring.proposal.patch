diff --git a/.github/workflows/parity.yml b/.github/workflows/parity.yml
--- a/.github/workflows/parity.yml
+++ b/.github/workflows/parity.yml
@@ -102,3 +102,70 @@
+  expression-parity:
+    name: BNG3 deterministic expression and trajectory parity
+    needs: oracle-lock
+    runs-on: ubuntu-22.04
+    steps:
+      - uses: actions/checkout@v4
+
+      - uses: actions/setup-python@v5
+        with:
+          python-version: "3.12"
+
+      - name: Install build and validation dependencies
+        run: |
+          sudo apt-get update
+          sudo apt-get install -y cmake ninja-build perl
+          python -m pip install pytest numpy pybind11
+
+      - name: Checkout locked BioNetGen oracle
+        run: |
+          python scripts/ci/checkout_oracle.py \
+            --name bionetgen \
+            --destination "$RUNNER_TEMP/oracle-bionetgen" \
+            --summary-file "$GITHUB_STEP_SUMMARY"
+
+      - name: Build BNG3 Python API and CLI
+        run: |
+          cmake -B build -G Ninja \
+            -DCMAKE_BUILD_TYPE=Release \
+            -DBUILD_PYTHON_BINDINGS=ON \
+            -DBUILD_CLI=ON \
+            -DBUILD_NFSIM_CLI=OFF \
+            -DBUILD_TESTS=OFF
+          cmake --build build --target bng_cpp _bionetgen_cpp --parallel 2
+
+      - name: Run deterministic expression, RHS, and ODE parity
+        shell: bash
+        run: |
+          set -euo pipefail
+          BNG2_PERL="$RUNNER_TEMP/oracle-bionetgen/bng2/BNG2.pl" \
+          BNGPATH="$RUNNER_TEMP/oracle-bionetgen/bng2" \
+          PYTHONPATH="python:build/cpp" \
+            python -m pytest -c tests/validation/pytest.ini \
+              tests/validation/test_compare_net.py \
+              tests/validation/test_compare_trajectories.py \
+              tests/validation/test_stochastic_comparator.py \
+              tests/validation/test_parity_stochastic.py \
+              tests/validation/test_oracle_perl.py \
+              tests/validation/test_rhs.py \
+              tests/validation/test_parity_rhs.py \
+              tests/validation/test_parity_expressions.py \
+              tests/validation/test_parity_ode.py \
+              -m "not slow" \
+              --bng-cpp build/cpp/bng_cpp -q
+          BNG2_DIGEST=$(sha256sum "$RUNNER_TEMP/oracle-bionetgen/bng2/BNG2.pl" | cut -d ' ' -f 1)
+          BNG3_CLI_DIGEST=$(sha256sum build/cpp/bng_cpp | cut -d ' ' -f 1)
+          BNG3_EXTENSION_DIGEST=$(find build/cpp -maxdepth 1 -name '_bionetgen_cpp*.so' -print0 | xargs -0 sha256sum)
+          {
+            echo "### Deterministic parity artifacts"
+            echo ""
+            echo "- BNG3 source revision: ${BNG3_SOURCE_REVISION}"
+            echo "- BNG2 script SHA-256: ${BNG2_DIGEST}"
+            echo "- BNG3 CLI SHA-256: ${BNG3_CLI_DIGEST}"
+            echo "- BNG3 extension: ${BNG3_EXTENSION_DIGEST}"
+          } >> "$GITHUB_STEP_SUMMARY"
+        env:
+          BNG3_SOURCE_REVISION: ${{ github.event.pull_request.head.sha || github.sha }}
+
   nfsim-parity:
     name: BNG3 vs independent NFsim
     needs: oracle-lock
