+end parameters
+begin molecule types
+ A(s~U~P)
+end molecule types
+begin energy patterns
+ A(s~P) G
+end energy patterns
+end model
+)BNG");
+    auto m3=bng::parser::parseModel(R"BNG(
+begin parameters
+ H 1
+end parameters
+begin molecule types
+ A(s~U~P)
+end molecule types
+begin energy patterns
+ A(s~P) H
