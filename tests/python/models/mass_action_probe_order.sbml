<?xml version="1.0" encoding="UTF-8"?>
<sbml xmlns="http://www.sbml.org/sbml/level3/version2/core" level="3" version="2">
  <model id="probe_order" name="probe_order" substanceUnits="mole"
         timeUnits="second" extentUnits="mole" volumeUnits="litre">
    <listOfCompartments>
      <compartment id="cell" spatialDimensions="3" size="1" constant="true"/>
    </listOfCompartments>
    <listOfSpecies>
      <species id="Aa" compartment="cell" initialAmount="1"
               hasOnlySubstanceUnits="false" boundaryCondition="false"
               constant="false"/>
      <species id="Bb" compartment="cell" initialAmount="1"
               hasOnlySubstanceUnits="false" boundaryCondition="false"
               constant="false"/>
    </listOfSpecies>
    <listOfParameters>
      <parameter id="k0" value="0.01" constant="true"/>
      <parameter id="k1" value="1e-06" constant="true"/>
      <parameter id="p1" value="0" constant="false"/>
      <parameter id="p2" value="0" constant="false"/>
    </listOfParameters>
    <listOfRules>
      <assignmentRule variable="p1">
        <math xmlns="http://www.w3.org/1998/Math/MathML"><cn>1</cn></math>
      </assignmentRule>
      <assignmentRule variable="p2">
        <math xmlns="http://www.w3.org/1998/Math/MathML"><cn>2</cn></math>
      </assignmentRule>
    </listOfRules>
    <listOfReactions>
      <reaction id="r" reversible="false">
        <listOfReactants>
          <speciesReference species="Aa" stoichiometry="1" constant="true"/>
        </listOfReactants>
        <listOfProducts>
          <speciesReference species="Bb" stoichiometry="1" constant="true"/>
        </listOfProducts>
        <kineticLaw>
          <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply><plus/>
              <apply><times/><ci>k0</ci><ci>Aa</ci></apply>
              <apply><times/><ci>k1</ci><ci>p2</ci></apply>
            </apply>
          </math>
        </kineticLaw>
      </reaction>
    </listOfReactions>
  </model>
</sbml>
