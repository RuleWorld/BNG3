###
#@notes:'This is a plain translation of an SBML model created on 30/10/2026. The original model has 2 molecules and 1 reactions. The translated model has 2 molecules and 2 rules'
###
begin model
begin parameters
  k0 0.01
  k1 1e-06
end parameters
begin molecule types
  Aa()
  Bb()
end molecule types
begin seed species
  Aa() 1.0 #Aa #Aa
  Bb() 1.0 #Bb #Bb
end seed species
begin observables
  Species Aa Aa() #Aa
  Species Bb Bb() #Bb
end observables
begin functions
  p2 = 2.0
  p1 = 1.0
  fRate0() = Aa*k0 + k1*p2
end functions
begin reaction rules
  r_reactants_0: 0 -> Aa() -1*(fRate0())
  r_products_0: 0 -> Bb() fRate0()
end reaction rules
end model