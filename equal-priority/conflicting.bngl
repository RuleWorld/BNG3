# BNGL model generated by the Playground-derived Python atomizer

# Model: equal-priority

# Species: 1, Reactions: 1

begin model

begin parameters
  __Avogadro__ 1
  __compartment_C__ 1
  k 1
end parameters

begin compartments
  C 3 1
end compartments

begin molecule types
  M_A()
end molecule types

begin seed species
  @C:M_A() 10
end seed species

begin observables
  Species A_amt @C:M_A() # A amount
  Species A @C:M_A() # A
end observables

begin functions
  _c_A() = A / __compartment_C__
end functions

begin reaction rules
  decay: @C:M_A() -> 0 1
end reaction rules

end model

