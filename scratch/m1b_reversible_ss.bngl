# M1b: REVERSIBLE ligand-receptor binding, steady state.
# Domain claim: with L + R <-> LR at (kon, koff), mass action gives the
# detailed-balance identity [L][R]/[LR] = Kd = koff/kon at steady state, and
# the species totals are each conserved.  Solving Kd*x = (L0-x)(R0-x) for the
# physically admissible root 0 <= x <= min(L0,R0) gives the exact [LR].
begin model
begin parameters
  kon  1e-4
  koff 0.5
  L0   100.0
  R0   60.0
end parameters
begin molecule types
  L(l)
  R(r)
end molecule types
begin seed species
  L(l) L0
  R(r) R0
end seed species
begin observables
  Molecules Lfree L(l)
  Molecules Rfree R(r)
  Molecules LR     L(l!1).R(r!1)
  Molecules Ltot   L
  Molecules Rtot   R
end observables
begin reaction rules
  L(l) + R(r) <-> L(l!1).R(r!1) kon, koff
end reaction rules
end model
begin actions
  simulate_ode({t_end=>20000,n_steps=>20000,atol=>1e-12,rtol=>1e-12})
end actions
