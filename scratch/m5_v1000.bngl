# M5b: the SAME concentrations at V = 1000 (counts = 1000x concentrations).
# Same kon and koff as m5_v1.  A second-order BNG rate constant is
# volume-independent, so the steady-state occupancy must be identical.
begin model
begin parameters
  kon  2e-3
  koff 0.4
end parameters
begin compartments
  mem 3 1000.0
end compartments
begin molecule types
  L(l)
  R(r)
end molecule types
begin seed species
  L(l)@mem 1000.0
  R(r)@mem 3000.0
end seed species
begin observables
  Molecules Lfree L(l)
  Molecules Rfree R(r)
  Molecules LR    L(l!1).R(r!1)
  Molecules Ltot  L
  Molecules Rtot  R
end observables
begin reaction rules
  L(l) + R(r) <-> L(l!1).R(r!1) kon, koff
end reaction rules
end model
begin actions
  generate_network({overwrite=>1})
  simulate_ode({t_end=>20000,n_steps=>20000,atol=>1e-12,rtol=>1e-12})
end actions
