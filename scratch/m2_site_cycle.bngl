# M2: closed two-state cycle on one phosphorylation site.
# Domain claim: R~U <-> R~P closes on itself, so [R~U]+[R~P] = Rtot is
# conserved and the closed system relaxes to the ratio of the two rate
# constants, [R~P]/[R~U] = k1/k2, with rate constant (k1+k2):
#   [R~P](t) = Rtot*k1/(k1+k2)*(1-exp(-(k1+k2)t))   for Rtot all unphosphorylated.
begin model
begin parameters
  k1 0.7
  k2 0.2
  Rtot 1000.0
end parameters
begin molecule types
  R(s~U~P)
end molecule types
begin seed species
  R(s~U) Rtot
end seed species
begin observables
  Molecules Rup  R(s~U)
  Molecules Rp   R(s~P)
  Molecules Rtot R
end observables
begin reaction rules
  R(s~U) -> R(s~P) k1
  R(s~P) -> R(s~U) k2
end reaction rules
end model
begin actions
  generate_network({overwrite=>1})
  simulate_ode({t_end=>60,n_steps=>6000,atol=>1e-12,rtol=>1e-12})
  writeNetwork({overwrite=>1,file=>"m2.net"})
end actions
