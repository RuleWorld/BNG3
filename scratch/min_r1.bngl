begin model
begin parameters
  ka 0.8
  kb 0.3
end parameters
begin molecule types
  A(s~U~P)
end molecule types
begin seed species
  A(s~U) 1000
end seed species
begin observables
  Molecules P A(s~P)
end observables
begin reaction rules
  A(s~U) -> A(s~P) ka, kb
end reaction rules
end model
begin actions
  generate_network({overwrite=>1})
  writeNetwork({overwrite=>1,file=>"min_r1.net"})
end actions
