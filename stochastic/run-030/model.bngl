# BNGL model generated by the Playground-derived Python atomizer

# Model: time-trigger

# Species: 1, Reactions: 1

begin model

begin parameters
  __Avogadro__ 1
  __compartment_C__ 1
  k 1
end parameters

begin compartments
  C 3 1
end compartments

begin molecule types
  M_A()
end molecule types

begin seed species
  @C:M_A() 60
end seed species

begin observables
  Species A_amt @C:M_A() # A amount
  Species A @C:M_A() # A
end observables

begin functions
  _c_A() = A / __compartment_C__
end functions

begin reaction rules
  decay: @C:M_A() -> 0 1
end reaction rules

end model

# ==== SBML DYNAMICS NOTES ====
# 1 time-triggered event(s) converted to scheduled actions.
# ============================

begin actions
# 1 time-triggered SBML event(s) translated to scheduled actions.
  generate_network({overwrite=>1})
  simulate({method=>"ssa", t_start=>0, t_end=>1, n_steps=>10, seed=>20260231})
  setConcentration("@C:M_A()", "40")
  simulate({continue=>1, method=>"ssa", t_start=>1, t_end=>2, n_steps=>10, seed=>20260231})
end actions

