begin model
begin molecule types
  A(b)
  B(b)
  C(b)
end molecule types
begin seed species
  A(b) 10
  B(b) 10
  C(b) 10
end seed species
begin reaction rules
  dimer0: A(b) + A(b) -> A(b!1).A(b!1) 0.01
  dimer1: B(b) + B(b) -> B(b!1).B(b!1) 0.01
  dimer2: C(b) + C(b) -> C(b!1).C(b!1) 0.01
end reaction rules
begin actions
  generate_network({overwrite=>1})
end actions
end model
